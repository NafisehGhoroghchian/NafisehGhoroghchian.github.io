---
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/posts';
import { href } from '../../lib/paths';

const posts = await getPosts();
---

<Base title="Blog" description="Notes on agentic LLM systems, RL post-training, evaluation, and graph ML.">
  <div class="hero">
    <h1>Blog</h1>
    <p class="focus">notes on agents, post-training, evaluation &amp; graph ML</p>
  </div>

  <section>
    {
      posts.length === 0 ? (
        <p class="prose">No posts yet.</p>
      ) : (
        <ul class="posts">
          {posts.map((post) => (
            <li>
              <time datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
                {post.data.draft && ' · draft'}
              </time>
              <h3><a href={href(`/blog/${post.id}`)}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
